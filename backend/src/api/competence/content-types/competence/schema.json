{
  "kind": "collectionType",
  "collectionName": "competences",
  "info": {
    "singularName": "competence",
    "pluralName": "competences",
    "displayName": "Competence",
    "description": "Compétences techniques et soft skills"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 100
    },
    "niveau": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "expert",
        "avance",
        "intermediaire",
        "débutant"
      ]
    },
    "icone": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "projets": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::projet.projet",
      "mappedBy": "competences"
    },
    "experiences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::experience.experience",
      "mappedBy": "competences"
    },
    "statut": {
      "type": "enumeration",
      "enum": ["brouillon", "pret_a_relire", "publie", "archive"],
      "default": "brouillon",
      "required": true
    },
  }
}
