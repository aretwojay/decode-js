{
  "kind": "collectionType",
  "collectionName": "expertises",
  "info": {
    "singularName": "expertise",
    "pluralName": "expertises",
    "displayName": "Expertise",
    "description": "Cartes de champs d'expertise / services affichées sur le portfolio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "profil": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profil.profil"
    },
    "titre": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 100
    },
    "description": {
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "icone": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "ordre": {
      "type": "integer",
      "default": 0
    },
    "statut": {
      "type": "enumeration",
      "required": true,
      "default": "brouillon",
      "enum": [
        "brouillon",
        "pret_a_relire",
        "publie",
        "archive"
      ]
    }
  }
}
