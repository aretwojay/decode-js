{
  "kind": "collectionType",
  "collectionName": "projets",
  "info": {
    "singularName": "projet",
    "pluralName": "projets",
    "displayName": "Projet",
    "description": "Projets du portfolio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "resume": {
      "type": "text"
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "technologies": {
      "type": "json"
    },
    "lien_repo": {
      "type": "string"
    },
    "lien_demo": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "en_vedette": {
      "type": "boolean",
      "default": false
    },
    "date_realisation": {
      "type": "date"
    },
    "statut": {
      "type": "enumeration",
      "required": true,
      "default": "brouillon",
      "enum": [
        "brouillon",
        "pret_a_relire",
        "publie",
        "archive"
      ]
    }
  }
}
