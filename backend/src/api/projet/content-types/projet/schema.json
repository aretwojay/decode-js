{
  "kind": "collectionType",
  "collectionName": "projets",
  "info": {
    "singularName": "projet",
    "pluralName": "projets",
    "displayName": "Projet",
    "description": "Projets du portfolio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "profil": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profil.profil"
    },
    "titre": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 150
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "resume": {
      "type": "text",
      "maxLength": 500
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "technologies": {
      "type": "text",
      "maxLength": 300
    },
    "competences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::competence.competence",
      "inversedBy": "projets"
    },
    "lien_repo": {
      "type": "string"
    },
    "lien_demo": {
      "type": "string"
    },
    "lien_mobile": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "maxLength": 150
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "en_vedette": {
      "type": "boolean",
      "default": false
    },
    "date_realisation": {
      "type": "date"
    },
    "statut": {
      "type": "enumeration",
      "required": true,
      "default": "brouillon",
      "enum": [
        "brouillon",
        "pret_a_relire",
        "publie",
        "archive"
      ]
    }
  }
}
