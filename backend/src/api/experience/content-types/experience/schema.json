{
  "kind": "collectionType",
  "collectionName": "experiences",
  "info": {
    "singularName": "experience",
    "pluralName": "experiences",
    "displayName": "Experience",
    "description": "Expériences professionnelles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "profil": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profil.profil"
    },
    "titre": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 150
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "entreprise": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 150
    },
    "date_debut": {
      "type": "date",
      "required": true
    },
    "date_fin": {
      "type": "date",
      "required": false
    },
    "competences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::competence.competence",
      "inversedBy": "experiences"
    },
    "statut": {
      "type": "enumeration",
      "enum": ["brouillon", "pret_a_relire", "publie", "archive"],
      "default": "brouillon",
      "required": true
    }
  }
}
